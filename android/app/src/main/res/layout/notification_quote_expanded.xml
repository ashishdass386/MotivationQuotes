<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <!-- Tag: DAILY REFLECTION -->
    <TextView
        android:id="@+id/notif_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAILY REFLECTION"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:letterSpacing="0.12"
        android:textAllCaps="true" />

    <!-- Hero Quote Typography (Serif, elegant, breathing room) -->
    <TextView
        android:id="@+id/notif_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="“Quote goes here”"
        android:fontFamily="serif"
        android:textSize="14.5sp"
        android:textColor="?android:attr/textColorPrimary"
        android:lineSpacingExtra="3dp" />

    <!-- Hairline Accent Divider -->
    <View
        android:layout_width="28dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#33888888" />

    <!-- Author Citation -->
    <TextView
        android:id="@+id/notif_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="— Author"
        android:textSize="11.5sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
